{
  "name": "api-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-mcp/src",
  "projectType": "library",
  "targets": {
    "list-tools": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run --script libs/api-mcp/src/server.py --list-tools" }
    },
    "spec-drift": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run --script libs/api-mcp/src/spec_drift.py" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --script libs/api-mcp/src/selftest.py",
          "uv run --script libs/api-mcp/examples/test_generate.py",
          "uv run --script libs/api-mcp/src/test_spec_drift.py"
        ],
        "parallel": false
      }
    }
  }
}
