{
  "mcpServers": {
    "flowaccount-acme": {
      "url": "https://mcp.flowaccount.com/mcp"
    },
    "flowaccount-acme-holding": {
      "url": "https://mcp.flowaccount.com/mcp"
    },
    "flowaccount-sandbox": {
      "url": "https://mcp.flowaccount.com/mcp"
    },
    "flowaccount-acme-api": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "/path/to/open-api/libs/api-mcp/src/server.py",
        "--profile",
        "flowaccount-acme-api"
      ]
    },
    "flowaccount-sandbox-api": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "/path/to/open-api/libs/api-mcp/src/server.py",
        "--profile",
        "flowaccount-sandbox-api",
        "--allow-write"
      ]
    }
  }
}
