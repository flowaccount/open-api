{
  "$comment": "Copy to ~/.config/flowaccount/openapi.json and chmod 600. One entry per company; the key is the name you pass with --profile.",
  "flowaccount-acme-api": {
    "client_id": "<client_id from FlowAccount developer settings>",
    "client_secret": "<client_secret>",
    "environment": "production"
  },
  "flowaccount-sandbox-api": {
    "client_id": "<sandbox client_id>",
    "client_secret": "<sandbox client_secret>",
    "environment": "sandbox",
    "allow_write": true
  }
}
